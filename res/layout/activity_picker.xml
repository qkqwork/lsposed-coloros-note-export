<?xml version="1.0" encoding="utf-8"?>
<!--
    The note picker: one tick box per note, handed over by the Notes app through
    the module's provider. Nothing here reads the notebook directly — this
    process cannot.

    It is a plain list rather than a RecyclerView on purpose: the Notes app has
    its own copy of AndroidX, and a module injected into it may not bring a
    second one along.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <TextView
        style="@style/NoteExport.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/picker_title" />

    <TextView
        style="@style/NoteExport.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_spacing"
        android:text="@string/picker_hint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_spacing"
        android:orientation="horizontal">

        <Button
            android:id="@+id/picker_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/picker_all" />

        <Button
            android:id="@+id/picker_none"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/item_spacing"
            android:layout_weight="1"
            android:text="@string/picker_none" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/item_spacing"
        android:layout_weight="1"
        android:background="@drawable/card_background"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:id="@+id/picker_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/picker_status"
        style="@style/NoteExport.Status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/picker_loading" />

    <Button
        android:id="@+id/picker_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_spacing"
        android:text="@string/picker_done" />
</LinearLayout>
