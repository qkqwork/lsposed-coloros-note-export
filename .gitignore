# Everything here is either reproducible or private. The module source, the
# docs and the analysis scripts are what belong in the repository.

# Downloads and extracted SDK used by build.ps1 (large, re-downloadable).
.buildtools/

# Build output, pulled device logs, disassembly dumps, and - most importantly -
# the notes this module was tested with: exported .docx/.png, note images and
# database dumps. None of that is source code and none of it should be pushed.
build/*
!build/*.py
!build/*.sh
!build/*.txt
# The full dexdump listings are hundreds of megabytes; they are regenerated by
# build/extract-capture.py, so only the small extracts next to them are kept.
build/dex*.txt
# These reports quote the note titles they were produced from, so they are
# personal data too. The scripts beside them regenerate the same information.
build/drawing-report.txt
build/long-image-check.txt
build/with-images.txt
# A dump of the device's LSPosed database, including the installed app list.
build/lsp-report.txt

# Scratch directories created by the tools while working on a device dump.
notesdb-*/
.verify-*/

# The signing key is private to this machine. build.ps1 regenerates it with
# keytool when it is missing; see BUILD.md.
keystore/

# Generated test output.
test/out/

# Editor and OS noise.
Thumbs.db
desktop.ini
*.swp
*~

# Scratch note left behind by a tool run.
build/last-backup-dir.txt

# Note text dumped for a single investigation; it is the user's own writing.
build/note-text*.txt
# Scratch pointer to the last export, rewritten by every run.
build/last-export-stamp.txt
